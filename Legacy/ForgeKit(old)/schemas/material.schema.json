{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "material.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "material.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "roughness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "metalness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "emissive": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "transparent": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "id",
    "color"
  ],
  "additionalProperties": false
}
