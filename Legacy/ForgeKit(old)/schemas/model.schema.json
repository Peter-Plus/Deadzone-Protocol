{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "model.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "type": {
      "enum": [
        "static",
        "humanoid"
      ]
    },
    "units": {
      "const": "meter"
    },
    "root": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "scale": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "rig": {
      "const": "humanoid.v1"
    },
    "body": {
      "type": "object",
      "properties": {
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "shoulderWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "hipWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "armLengthScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "legLengthScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "headScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "handScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "footScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "bodyThickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "material": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "parent": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "shape": {
            "enum": [
              "box",
              "sphere",
              "cylinder",
              "capsule",
              "cone",
              "plane"
            ]
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "scale": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minItems": 3,
                "maxItems": 3
              }
            ]
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minItems": 3,
            "maxItems": 3
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "length": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "axis": {
            "enum": [
              "x",
              "y",
              "z"
            ]
          },
          "material": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        },
        "required": [
          "id",
          "shape"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "shape": {
                  "enum": [
                    "box",
                    "plane"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "size"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "shape": {
                  "enum": [
                    "sphere",
                    "cylinder",
                    "capsule",
                    "cone"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "radius"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "shape": {
                  "enum": [
                    "cylinder",
                    "capsule",
                    "cone"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "length"
              ]
            }
          }
        ]
      }
    },
    "sockets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "parent": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "scale": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minItems": 3,
                "maxItems": 3
              }
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "type"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "humanoid"
          }
        }
      },
      "then": {
        "required": [
          "rig",
          "body"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "static"
          }
        }
      },
      "then": {
        "required": [
          "parts"
        ],
        "properties": {
          "parts": {
            "minItems": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "rig"
              ]
            },
            {
              "required": [
                "body"
              ]
            }
          ]
        }
      }
    }
  ]
}
