{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "animation.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "animation.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "rig": {
      "const": "humanoid.v1"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "loop": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "timeline",
        "generator"
      ]
    },
    "tracks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "time": {
              "type": "number",
              "minimum": 0
            },
            "rotation": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "position": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "time"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "rotation"
              ]
            },
            {
              "required": [
                "position"
              ]
            }
          ]
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0
          },
          "pose": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        },
        "required": [
          "time",
          "pose"
        ],
        "additionalProperties": false
      }
    },
    "generator": {
      "enum": [
        "humanoid.idle",
        "humanoid.breathing",
        "humanoid.walk",
        "humanoid.run"
      ]
    },
    "parameters": {
      "type": "object",
      "properties": {
        "strideAngle": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "kneeBend": {
          "type": "number",
          "minimum": 0,
          "maximum": 140
        },
        "armSwing": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "bodyBob": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2
        },
        "hipTwist": {
          "type": "number",
          "minimum": 0,
          "maximum": 45
        },
        "lean": {
          "type": "number",
          "minimum": -60,
          "maximum": 60
        },
        "breath": {
          "type": "number",
          "minimum": 0,
          "maximum": 15
        },
        "samples": {
          "type": "integer",
          "minimum": 8,
          "maximum": 240
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "rig",
    "duration",
    "loop",
    "mode"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "generator"
          }
        }
      },
      "then": {
        "required": [
          "generator"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "tracks"
              ]
            },
            {
              "required": [
                "timeline"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "timeline"
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "tracks"
            ]
          },
          {
            "required": [
              "timeline"
            ]
          }
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "generator"
              ]
            },
            {
              "required": [
                "parameters"
              ]
            }
          ]
        }
      }
    }
  ]
}
