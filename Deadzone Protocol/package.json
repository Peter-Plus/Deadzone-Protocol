{
  "name": "deadzone-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/build.mjs --serve",
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
