    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
