{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "model.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "type": {
      "enum": [
        "static",
        "humanoid",
        "fps_arms"
      ]
    },
    "rig": {
      "enum": [
        "humanoid.v1",
        "humanoid.v2",
        "fps-arms.v1"
      ]
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "scale": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        }
      },
      "required": []
    },
    "rigPose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "UpperArm_L": {
          "type": "number"
        },
        "Forearm_L": {
          "type": "number"
        },
        "UpperArm_R": {
          "type": "number"
        },
        "Forearm_R": {
          "type": "number"
        }
      },
      "required": []
    },
    "jointPositions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Forearm_L": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "minItems": 3,
          "maxItems": 3
        },
        "Hand_L": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "minItems": 3,
          "maxItems": 3
        },
        "Forearm_R": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "minItems": 3,
          "maxItems": 3
        },
        "Hand_R": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "minItems": 3,
          "maxItems": 3
        },
        "LowerLeg_L": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "minItems": 3,
          "maxItems": 3
        },
        "LowerLeg_R": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": []
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "bodyWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "bodyDepth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "headScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "armLength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "armThickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "legLength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "legThickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        }
      },
      "required": []
    },
    "materials": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "roughness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "metalness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "emissive": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "transparent": {
                "type": "boolean"
              }
            },
            "required": []
          }
        ]
      }
    },
    "parts": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "parent": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "shape": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "box"
                  },
                  "size": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 10000
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "type",
                  "size"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "sphere"
                  },
                  "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  }
                },
                "required": [
                  "type",
                  "radius"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "cylinder"
                  },
                  "radiusTop": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "radiusBottom": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  }
                },
                "required": [
                  "type",
                  "radiusTop",
                  "radiusBottom",
                  "height"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "capsule"
                  },
                  "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  "length": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  }
                },
                "required": [
                  "type",
                  "radius",
                  "length"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "cone"
                  },
                  "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  "radialSegments": {
                    "type": "integer",
                    "minimum": 3,
                    "maximum": 64
                  }
                },
                "required": [
                  "type",
                  "radius",
                  "height"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "plane"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  }
                },
                "required": [
                  "type",
                  "width",
                  "height"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "rock"
                  },
                  "size": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 10000
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                },
                "required": [
                  "type",
                  "size",
                  "seed"
                ]
              }
            ]
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "scale": {
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000
                },
                "minItems": 3,
                "maxItems": 3
              }
            ]
          },
          "material": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "roughness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "metalness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "emissive": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "transparent": {
                    "type": "boolean"
                  }
                },
                "required": []
              }
            ]
          }
        },
        "required": [
          "id",
          "shape"
        ]
      }
    },
    "sockets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "parent": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "scale": {
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000
                },
                "minItems": 3,
                "maxItems": 3
              }
            ]
          }
        },
        "required": [
          "id",
          "parent"
        ]
      }
    }
  },
  "required": [
    "schema",
    "id",
    "type"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "humanoid"
          }
        }
      },
      "then": {
        "required": [
          "rig"
        ],
        "properties": {
          "rig": {
            "enum": [
              "humanoid.v1",
              "humanoid.v2"
            ]
          },
          "rigPose": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "fps_arms"
          }
        }
      },
      "then": {
        "required": [
          "rig",
          "parts"
        ],
        "properties": {
          "rig": {
            "const": "fps-arms.v1"
          },
          "parts": {
            "minItems": 1
          },
          "parameters": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "static"
          }
        }
      },
      "then": {
        "required": [
          "parts"
        ],
        "properties": {
          "parts": {
            "minItems": 1
          },
          "rig": false,
          "parameters": false,
          "rigPose": false
        }
      }
    },
    {
      "if": {
        "required": [
          "rig"
        ],
        "properties": {
          "rig": {
            "const": "humanoid.v2"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "if": {
              "required": [
                "jointPositions"
              ]
            },
            "then": {
              "required": [
                "parts"
              ],
              "properties": {
                "parts": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "jointPositions": false
        }
      }
    }
  ]
}
